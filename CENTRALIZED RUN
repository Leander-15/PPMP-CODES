function testCentralPipeline() {

  Logger.log(
    "================================================"
  );

  Logger.log(
    "CENTRAL MANUAL PIPELINE TEST START"
  );

  Logger.log(
    "================================================"
  );


  const lock =
    LockService.getScriptLock();


  if (
    !lock.tryLock(
      CENTRAL_LOCK_TIMEOUT
    )
  ) {

    throw new Error(
      "Another central process is currently running."
    );

  }


  try {

    syncAllPurchaseOrdersCentral_();

    SpreadsheetApp.flush();

    syncAllBacResCentral_();

    SpreadsheetApp.flush();

    syncAllContractNumbersCentral_();

    SpreadsheetApp.flush();


    Logger.log(
      "================================================"
    );

    Logger.log(
      "CENTRAL MANUAL PIPELINE TEST COMPLETE"
    );

    Logger.log(
      "================================================"
    );


  } finally {

    lock.releaseLock();

  }

}

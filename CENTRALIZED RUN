function syncAllContractNumbersCentral_() {

  Logger.log(
    "----- CENTRAL CONTRACT SYNC START -----"
  );


  const sources =
    getUniqueSourceDatabases_();


  sources.forEach(
    source => {

      Logger.log(
        "CONTRACT PROCESSING: " +
        source.name
      );


      const lean =
        getLeanDatabaseCentral_(
          source
        );


      syncContractNumbersCentral_(
        source,
        lean.sourceSheet
      );


      Logger.log(
        "CONTRACT COMPLETE: " +
        source.name
      );

    }
  );


  Logger.log(
    "----- CENTRAL CONTRACT SYNC COMPLETE -----"
  );

}


// ============================================================
// CONTRACT SYNC
// ============================================================

function syncContractNumbersCentral_(
  source,
  sourceSheet
) {

  const DB_COL_PR_NO = 1;
  const DB_COL_ABC = 8;
  const DB_COL_PURPOSE = 10;
  const DB_COL_SUPPLIER = 30;
  const DB_COL_CONTRACT_PRICE = 32;
  const DB_COL_CATEGORY = 33;
  const DB_COL_CONTRACT_NO = 44;   // AR
  const DB_COL_DOCUMENT_TYPE = 47; // AU


  const targetSheet =
    getCentralSheet_(
      CENTRAL_SHEETS.CONTRACTS
    );


  const sourceData =
    sourceSheet
      .getDataRange()
      .getValues();


  const targetData =
    targetSheet
      .getDataRange()
      .getValues();


  // ----------------------------------------------------------
  // EXISTING CONTRACT MAP
  // ----------------------------------------------------------

  const existingContractMap =
    new Map();


  let maxControlNo =
    0;


  for (
    let i = 1;
    i < targetData.length;
    i++
  ) {

    const contractNo =
      cleanValueCentral_(
        targetData[i][0]
      );


    const prNo =
      cleanValueCentral_(
        targetData[i][2]
      );


    const supplier =
      cleanValueCentral_(
        targetData[i][4]
      );


    const amount =
      cleanNumberCentral_(
        targetData[i][7]
      );


    if (
      contractNo
    ) {

      const match =
        contractNo.match(
          /(\d+)$/
        );


      if (match) {

        const num =
          Number(
            match[1]
          );


        if (
          num > maxControlNo
        ) {

          maxControlNo =
            num;

        }

      }

    }


    if (
      !contractNo ||
      !supplier ||
      !amount ||
      !prNo
    ) {

      continue;

    }


    const key =
      makeContractKeyCentral_(
        prNo,
        supplier,
        amount
      );


    existingContractMap.set(
      key,
      contractNo
    );

  }


  // ----------------------------------------------------------
  // ABC MAP
  // ----------------------------------------------------------

  const abcMap =
    new Map();


  let currentPrNoForAbc =
    "";

  let currentCategoryForAbc =
    "";


  for (
    let i = 1;
    i < sourceData.length;
    i++
  ) {

    const prNo =
      cleanValueCentral_(
        sourceData[i][
          DB_COL_PR_NO - 1
        ]
      );


    const category =
      cleanValueCentral_(
        sourceData[i][
          DB_COL_CATEGORY - 1
        ]
      );


    const potentialAbc =
      cleanNumberCentral_(
        sourceData[i][
          DB_COL_ABC - 1
        ]
      );


    if (prNo !== "") {

      currentPrNoForAbc =
        prNo;

    }


    if (category !== "") {

      currentCategoryForAbc =
        category;

    }


    if (
      currentPrNoForAbc &&
      potentialAbc > 0
    ) {

      abcMap.set(

        currentPrNoForAbc.toUpperCase() +
        "||" +
        currentCategoryForAbc.toUpperCase(),

        potentialAbc

      );

    }

  }


  // ----------------------------------------------------------
  // GROUP CONTRACT DATA
  // ----------------------------------------------------------

  const grouped =
    new Map();


  let currentDocumentType =
    "";

  let currentBlockTracker =
    "";

  let currentPrNoForGrouping =
    "";

  let currentCategoryForGrouping =
    "";


  for (
    let i = 1;
    i < sourceData.length;
    i++
  ) {

    const row =
      sourceData[i];


    const prNo =
      cleanValueCentral_(
        row[
          DB_COL_PR_NO - 1
        ]
      );


    const category =
      cleanValueCentral_(
        row[
          DB_COL_CATEGORY - 1
        ]
      );


    // --------------------------------------------------------
    // CARRY CONTEXT DOWNWARD
    // --------------------------------------------------------

    if (prNo !== "") {

      currentPrNoForGrouping =
        prNo;

    }


    if (category !== "") {

      currentCategoryForGrouping =
        category;

    }


    const blockKey =
      currentPrNoForGrouping +
      "||" +
      currentCategoryForGrouping;


    if (
      blockKey !==
      currentBlockTracker
    ) {

      currentDocumentType =
        "";

      currentBlockTracker =
        blockKey;

    }


    const documentTypeCell =
      cleanValueCentral_(
        row[
          DB_COL_DOCUMENT_TYPE - 1
        ]
      );


    if (
      documentTypeCell !== ""
    ) {

      currentDocumentType =
        documentTypeCell.toUpperCase();

    }


    if (
      currentDocumentType !==
      "CONTRACT"
    ) {

      continue;

    }


    const supplier =
      cleanValueCentral_(
        row[
          DB_COL_SUPPLIER - 1
        ]
      );


    const contractPrice =
      cleanNumberCentral_(
        row[
          DB_COL_CONTRACT_PRICE - 1
        ]
      );


    const existingContractNo =
      cleanValueCentral_(
        row[
          DB_COL_CONTRACT_NO - 1
        ]
      );


    // --------------------------------------------------------
    // REQUIRED / VITAL DATA
    // --------------------------------------------------------

    if (
      !currentPrNoForGrouping ||
      !supplier ||
      !contractPrice
    ) {

      continue;

    }


    const key =
      makeContractKeyCentral_(
        currentPrNoForGrouping,
        supplier,
        contractPrice
      );


    if (!grouped.has(key)) {

      const abcKey =
        currentPrNoForGrouping.toUpperCase() +
        "||" +
        currentCategoryForGrouping.toUpperCase();


      const prAbc =
        abcMap.has(abcKey)
          ? abcMap.get(abcKey)
          : 0;


      grouped.set(
        key,
        {
          prNo:
            currentPrNoForGrouping,

          supplier:
            supplier,

          purpose:
            row[
              DB_COL_PURPOSE - 1
            ],

          abc:
            prAbc,

          contractPrice:
            contractPrice,

          firstRow:
            i + 1,

          databaseRows:
            [],

          existingControlNumbers:
            []

        }
      );

    }


    const group =
      grouped.get(key);


    group.databaseRows.push(
      i + 1
    );


    if (existingContractNo) {

      group.existingControlNumbers.push(
        existingContractNo
      );

    }

  }


  // ----------------------------------------------------------
  // NUMBERING
  // ----------------------------------------------------------

  let nextContractControlNo =
    maxControlNo + 1;


  let rowsWritten =
    0;


  let matchedExistingCentral =
    0;


  let skippedAlreadyNumbered =
    0;


  const updates =
    [];


  const today =
    new Date();


  // ----------------------------------------------------------
  // PROCESS CONTRACT GROUPS
  // ----------------------------------------------------------

  for (
    const [key, item]
    of grouped
  ) {

    // ========================================================
    // 1. LEAN AR CHECK
    // ========================================================
    //
    // If ANY row in the contract group already has AR,
    // skip the ENTIRE group.
    // ========================================================

    if (
      item.existingControlNumbers.length > 0
    ) {

      skippedAlreadyNumbered++;

      Logger.log(
        source.name +
        ": CONTRACT GROUP SKIPPED — already has AR number: " +
        item.existingControlNumbers.join(", ")
      );

      continue;

    }


    // ========================================================
    // 2. SEARCH CENTRAL CONTRACT SHEET
    // ========================================================
    //
    // If match exists:
    //
    // DO NOT WRITE CENTRAL.
    //
    // Only copy existing number to first LEAN row.
    // ========================================================

    if (
      existingContractMap.has(key)
    ) {

      const existingContractNo =
        existingContractMap.get(key);


      updates.push({
        row:
          item.firstRow,

        value:
          existingContractNo
      });


      matchedExistingCentral++;


      Logger.log(
        source.name +
        ": CONTRACT MATCH FOUND IN CENTRAL → " +
        existingContractNo +
        " → LEAN row " +
        item.firstRow
      );


      continue;

    }


    // ========================================================
    // 3. NO CENTRAL MATCH → CREATE NEW CONTRACT
    // ========================================================

    const contractNo =
      generateContractNumberCentral_(
        today,
        nextContractControlNo
      );


    nextContractControlNo++;


    const nextAvailable =
      getNextAvailableContractRowCentral_(
        targetSheet
      );

    const targetRow =
      nextAvailable.row;


    // --------------------------------------------------------
    // WRITE NEW CONTRACT TO CENTRAL
    // --------------------------------------------------------

    targetSheet
      .getRange(
        targetRow,
        1
      )
      .setValue(
        contractNo
      );


    targetSheet
      .getRange(
        targetRow,
        3,
        1,
        6
      )
      .setValues([[
        item.prNo,
        today,
        item.supplier,
        item.purpose,
        item.abc,
        item.contractPrice
      ]]);


    targetSheet
      .getRange(
        targetRow,
        4
      )
      .setNumberFormat(
        "mmmm d, yyyy"
      );


    targetSheet
      .getRange(
        targetRow,
        8
      )
      .setNumberFormat(
        "#,##0.00"
      );


    existingContractMap.set(
      key,
      contractNo
    );


    rowsWritten++;


    // --------------------------------------------------------
    // WRITE CONTRACT NUMBER ONLY TO FIRST ROW OF LEAN
    // --------------------------------------------------------

    updates.push({
      row:
        item.firstRow,

      value:
        contractNo
    });


    Logger.log(
      source.name +
      ": NEW CONTRACT CREATED → " +
      contractNo +
      " → LEAN row " +
      item.firstRow
    );

  }


  // ----------------------------------------------------------
  // WRITE CONTRACT NUMBER BACK TO AR
  // ----------------------------------------------------------
  //
  // ONLY FIRST ROW OF EACH GROUP.
  // ----------------------------------------------------------

  updates.forEach(
    update => {

      sourceSheet
        .getRange(
          update.row,
          DB_COL_CONTRACT_NO
        )
        .setValue(
          update.value
        );

    }
  );


  SpreadsheetApp.flush();


  Logger.log(
    source.name +
    ": " +
    rowsWritten +
    " NEW Contract row(s) written to Central."
  );


  Logger.log(
    source.name +
    ": " +
    matchedExistingCentral +
    " Contract group(s) matched existing Central records."
  );


  Logger.log(
    source.name +
    ": " +
    skippedAlreadyNumbered +
    " Contract group(s) skipped because AR already contained a number."
  );


  Logger.log(
    source.name +
    ": " +
    updates.length +
    " LEAN first-row Contract control number(s) updated."
  );

}


// ============================================================
// CONTRACT HELPERS
// ============================================================

function getNextAvailableContractRowCentral_(
  sheet
) {

  const START_ROW =
    2;

  const maxRows =
    sheet.getMaxRows();


  const values =
    sheet
      .getRange(
        START_ROW,
        1,
        maxRows - START_ROW + 1,
        8
      )
      .getValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const contractNo =
      cleanValueCentral_(
        values[i][0]
      );


    const data =
      values[i].slice(
        2,
        8
      );


    const blank =
      data.every(
        cell =>
          cleanValueCentral_(cell) === ""
      );


    if (blank) {

      return {
        row:
          START_ROW + i,

        existingContractNo:
          contractNo
      };

    }

  }


  sheet.insertRowAfter(
    maxRows
  );


  return {
    row:
      maxRows + 1,

    existingContractNo:
      ""
  };

}


function generateContractNumberCentral_(
  dateObj,
  controlNo
) {

  const year =
    dateObj.getFullYear();


  const month =
    String(
      dateObj.getMonth() + 1
    ).padStart(
      2,
      "0"
    );


  return (
    year +
    "." +
    month +
    "." +
    controlNo
  );

}


function makeContractKeyCentral_(
  prNo,
  supplier,
  contractPrice
) {

  return [

    cleanValueCentral_(
      prNo
    ).toUpperCase(),

    cleanValueCentral_(
      supplier
    ).toUpperCase(),

    cleanNumberCentral_(
      contractPrice
    )

  ].join("||");

}


// ============================================================
// COMMON HELPERS
// ============================================================

function lowerFirstLetterCentral_(
  text
) {

  text =
    cleanValueCentral_(
      text
    );


  if (!text) {

    return "";

  }


  return (
    text.charAt(0).toLowerCase() +
    text.slice(1)
  );

}


function toTitleCaseCentral_(
  text
) {

  return String(text)
    .toLowerCase()
    .split(" ")
    .map(
      word =>
        word
          ? word.charAt(0).toUpperCase() +
            word.slice(1)
          : ""
    )
    .join(" ");

}


function cleanValueCentral_(
  value
) {

  return String(
    value == null
      ? ""
      : value
  ).trim();

}


function cleanNumberCentral_(
  value
) {

  if (
    value === "" ||
    value == null
  ) {

    return 0;

  }


  const cleaned =
    String(value)
      .replace(
        /[₱,\s]/g,
        ""
      )
      .trim();


  return (
    Number(cleaned) ||
    0
  );

}



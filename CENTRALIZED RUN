// ============================================================
// BAC RES SYNC
// ============================================================

function syncBacResCentral_(
  source,
  sourceSheet
) {

  const DB_COL_PR_NO = 1;
  const DB_COL_PURPOSE = 10;
  const DB_COL_DIVISION = 12;
  const DB_COL_SUPPLIER = 30;
  const DB_COL_AMOUNT = 32;
  const DB_COL_CATEGORY = 33;
  const DB_COL_BACRES_NO = 43;         // AQ
  const DB_COL_PO_NO = 44;             // AR
  const DB_COL_PROCUREMENT_TYPE = 45;  // AS


  const targetSheet =
    getCentralSheet_(
      CENTRAL_SHEETS.BACRES
    );


  const poSheet =
    getCentralSheet_(
      CENTRAL_SHEETS.PURCHASE_ORDERS
    );


  const sourceData =
    sourceSheet
      .getDataRange()
      .getValues();


  const targetData =
    targetSheet
      .getDataRange()
      .getValues();


  const poData =
    poSheet
      .getDataRange()
      .getValues();


  if (
    sourceData.length < 2
  ) {

    Logger.log(
      source.name +
      ": No DATABASE data for BAC RES."
    );

    return;

  }


  // ----------------------------------------------------------
  // EXISTING BAC RES MAP
  // ----------------------------------------------------------

  const existingBacMap =
    new Map();


  for (
    let i = 1;
    i < targetData.length;
    i++
  ) {

    const row =
      targetData[i];


    const prNo =
      cleanValueCentral_(
        row[0]
      );

    const supplier =
      cleanValueCentral_(
        row[3]
      );

    const purpose =
      cleanValueCentral_(
        row[4]
      );

    const amount =
      cleanNumberCentral_(
        row[5]
      );

    const category =
      cleanValueCentral_(
        row[6]
      );

    const bacResNo =
      cleanValueCentral_(
        row[7]
      );

    const poNo =
      cleanValueCentral_(
        row[12]
      );


    if (
      !prNo ||
      !category ||
      !supplier ||
      !amount ||
      !purpose ||
      !bacResNo
    ) {

      continue;

    }


    const key =
      makeFullKeyWithPurposeCentral_(
        prNo,
        category,
        supplier,
        amount,
        purpose
      );


    existingBacMap.set(
      key,
      {
        rowNumber:
          i + 1,

        bacResNo:
          bacResNo,

        poNo:
          poNo
      }
    );

  }


  // ----------------------------------------------------------
  // PO MAP
  // ----------------------------------------------------------
  //
  // Used ONLY to populate Central BAC RES column M.
  //
  // It does NOT write PO numbers back into LEAN AR.
  // PO numbers are controlled exclusively by PO sync.
  // ----------------------------------------------------------

  const poMap =
    new Map();


  for (
    let i = 1;
    i < poData.length;
    i++
  ) {

    const poNo =
      cleanValueCentral_(
        poData[i][0]
      );

    const supplier =
      cleanValueCentral_(
        poData[i][2]
      );

    const amount =
      cleanNumberCentral_(
        poData[i][5]
      );

    const category =
      cleanValueCentral_(
        poData[i][6]
      );

    const prNo =
      cleanValueCentral_(
        poData[i][7]
      );


    if (
      !poNo ||
      !prNo ||
      !category ||
      !supplier ||
      !amount
    ) {

      continue;

    }


    const fullKey =
      makeFullKeyCentral_(
        prNo,
        category,
        supplier,
        amount
      );


    poMap.set(
      fullKey,
      poNo
    );

  }


  // ----------------------------------------------------------
  // GROUP DATABASE
  // ----------------------------------------------------------

  const grouped =
    new Map();


  for (
    let i = 1;
    i < sourceData.length;
    i++
  ) {

    const row =
      sourceData[i];


    const prNo =
      cleanValueCentral_(
        row[DB_COL_PR_NO - 1]
      );

    const purposeText =
      cleanValueCentral_(
        row[DB_COL_PURPOSE - 1]
      );

    const division =
      cleanValueCentral_(
        row[DB_COL_DIVISION - 1]
      );

    const supplier =
      cleanValueCentral_(
        row[DB_COL_SUPPLIER - 1]
      );

    const amount =
      cleanNumberCentral_(
        row[DB_COL_AMOUNT - 1]
      );

    const category =
      cleanValueCentral_(
        row[DB_COL_CATEGORY - 1]
      );

    const bacResNoInDb =
      cleanValueCentral_(
        row[DB_COL_BACRES_NO - 1]
      );

    const procurementType =
      cleanValueCentral_(
        row[DB_COL_PROCUREMENT_TYPE - 1]
      );


    // --------------------------------------------------------
    // REQUIRED / VITAL DATA
    // --------------------------------------------------------

    if (
      !prNo ||
      !category ||
      !supplier ||
      !purposeText ||
      !amount
    ) {

      continue;

    }


    const finalPurpose =
      buildPurposeBacCentral_(
        category,
        purposeText,
        procurementType
      );


    const keyWithPurpose =
      makeFullKeyWithPurposeCentral_(
        prNo,
        category,
        supplier,
        amount,
        finalPurpose
      );


    const normalKey =
      makeFullKeyCentral_(
        prNo,
        category,
        supplier,
        amount
      );


    if (!grouped.has(keyWithPurpose)) {

      grouped.set(
        keyWithPurpose,
        {
          prNo:
            prNo,

          purposeText:
            purposeText,

          finalPurpose:
            finalPurpose,

          division:
            division,

          supplier:
            supplier,

          amount:
            amount,

          category:
            category,

          procurementType:
            procurementType,

          normalKey:
            normalKey,

          firstRow:
            i + 1,

          rowNumbers:
            [],

          existingControlNumbers:
            []

        }
      );

    }


    const group =
      grouped.get(
        keyWithPurpose
      );


    group.rowNumbers.push(
      i + 1
    );


    if (bacResNoInDb) {

      group.existingControlNumbers.push(
        bacResNoInDb
      );

    }

  }


  // ----------------------------------------------------------
  // NUMBERING
  // ----------------------------------------------------------

  let nextControlNo =
    getNextControlNumberFromColumnH_BacCentral_(
      targetSheet
    );


  const now =
    new Date();


  let rowsAdded =
    0;


  let matchedExistingCentral =
    0;


  let skippedAlreadyNumbered =
    0;


  const databaseUpdates =
    [];


  // ----------------------------------------------------------
  // PROCESS BAC RES GROUPS
  // ----------------------------------------------------------

  for (
    const [key, item]
    of grouped.entries()
  ) {

    // ========================================================
    // 1. LEAN AQ CHECK
    // ========================================================
    //
    // If ANY row in the group already has AQ populated,
    // the entire BAC RES group is skipped.
    //
    // No Central search.
    // No Central write.
    // No new number.
    //
    // ========================================================

    if (
      item.existingControlNumbers.length > 0
    ) {

      skippedAlreadyNumbered++;

      Logger.log(
        source.name +
        ": BAC RES GROUP SKIPPED — already has AQ number: " +
        item.existingControlNumbers.join(", ")
      );

      continue;

    }


    // ========================================================
    // 2. SEARCH CENTRAL BAC RES
    // ========================================================

    if (
      existingBacMap.has(key)
    ) {

      const existing =
        existingBacMap.get(
          key
        );


      // IMPORTANT:
      // Do NOT write anything to Central.
      //
      // Only copy the existing control number
      // to FIRST ROW of LEAN.

      databaseUpdates.push({
        row:
          item.firstRow,

        value:
          existing.bacResNo
      });


      matchedExistingCentral++;


      Logger.log(
        source.name +
        ": BAC RES MATCH FOUND IN CENTRAL → " +
        existing.bacResNo +
        " → LEAN row " +
        item.firstRow
      );


      continue;

    }


    // ========================================================
    // 3. NO CENTRAL MATCH → CREATE NEW BAC RES
    // ========================================================

    const targetRow =
      findNextWritableBacCentral_(
        targetSheet
      );


    // --------------------------------------------------------
    // PO NUMBER FOR CENTRAL COLUMN M ONLY
    // --------------------------------------------------------

    const poNo =
      poMap.get(
        item.normalKey
      ) || "";


    // --------------------------------------------------------
    // WRITE A:G
    // --------------------------------------------------------

    targetSheet
      .getRange(
        targetRow,
        1,
        1,
        7
      )
      .setValues([[
        item.prNo,
        now,
        mapDivisionBacCentral_(
          item.division
        ),
        item.supplier,
        item.finalPurpose,
        item.amount,
        item.category
      ]]);


    // --------------------------------------------------------
    // WRITE M - PO NO.
    // --------------------------------------------------------

    targetSheet
      .getRange(
        targetRow,
        13
      )
      .setValue(
        poNo
      );


    targetSheet
      .getRange(
        targetRow,
        2
      )
      .setNumberFormat(
        "mmmm d, yyyy"
      );


    targetSheet
      .getRange(
        targetRow,
        6
      )
      .setNumberFormat(
        "#,##0.00"
      );


    SpreadsheetApp.flush();


    // --------------------------------------------------------
    // GET PREPARED BAC RES NUMBER FROM H
    // --------------------------------------------------------

    let bacResNo =
      cleanValueCentral_(
        targetSheet
          .getRange(
            targetRow,
            8
          )
          .getValue()
      );


    const currentYear =
      now
        .getFullYear()
        .toString();


    const currentMonth =
      String(
        now.getMonth() + 1
      ).padStart(
        2,
        "0"
      );


    let isCurrentSeries =
      false;


    if (bacResNo) {

      const parts =
        bacResNo.split(".");


      if (
        parts.length === 3 &&
        parts[0] === currentYear &&
        parts[1] === currentMonth
      ) {

        isCurrentSeries =
          true;

      }

    }


    // --------------------------------------------------------
    // GENERATE NEW BAC RES IF NECESSARY
    // --------------------------------------------------------

    if (!isCurrentSeries) {

      bacResNo =
        generateSeriesNumberBacCentral_(
          now,
          nextControlNo
        );

      nextControlNo++;

    }


    // --------------------------------------------------------
    // WRITE H:J
    // --------------------------------------------------------

    targetSheet
      .getRange(
        targetRow,
        8,
        1,
        3
      )
      .setValues([[
        bacResNo,
        bacResNo,
        bacResNo
      ]]);


    rowsAdded++;


    // --------------------------------------------------------
    // WRITE AQ ONLY TO FIRST ROW OF LEAN GROUP
    // --------------------------------------------------------

    databaseUpdates.push({
      row:
        item.firstRow,

      value:
        bacResNo
    });


    existingBacMap.set(
      key,
      {
        rowNumber:
          targetRow,

        bacResNo:
          bacResNo,

        poNo:
          poNo
      }
    );


    Logger.log(
      source.name +
      ": NEW BAC RES CREATED → " +
      bacResNo +
      " → LEAN row " +
      item.firstRow
    );

  }


  // ----------------------------------------------------------
  // BACKFILL AQ
  // ----------------------------------------------------------

  databaseUpdates.forEach(
    update => {

      sourceSheet
        .getRange(
          update.row,
          DB_COL_BACRES_NO
        )
        .setValue(
          update.value
        );

    }
  );


  SpreadsheetApp.flush();


  Logger.log(
    source.name +
    ": " +
    rowsAdded +
    " NEW BAC RES row(s) written to Central."
  );


  Logger.log(
    source.name +
    ": " +
    matchedExistingCentral +
    " BAC RES group(s) matched existing Central records."
  );


  Logger.log(
    source.name +
    ": " +
    skippedAlreadyNumbered +
    " BAC RES group(s) skipped because AQ already contained a number."
  );


  Logger.log(
    source.name +
    ": " +
    databaseUpdates.length +
    " LEAN first-row BAC RES control number(s) updated."
  );

}


// ============================================================
// BAC RES HELPERS
// ============================================================

function findNextWritableBacCentral_(
  sheet
) {

  const lastRow =
    Math.max(
      sheet.getLastRow(),
      2
    );


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        7
      )
      .getValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    const hasData =
      row.some(
        cell =>
          cleanValueCentral_(cell) !== ""
      );


    if (!hasData) {

      return i + 2;

    }

  }


  return lastRow + 1;

}


function getNextControlNumberFromColumnH_BacCentral_(
  sheet
) {

  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {

    return 1;

  }


  const values =
    sheet
      .getRange(
        2,
        8,
        lastRow - 1,
        1
      )
      .getValues();


  let maxControlNo =
    0;


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const seriesNo =
      cleanValueCentral_(
        values[i][0]
      );


    if (!seriesNo) {

      continue;

    }


    const parts =
      seriesNo.split(".");


    if (
      parts.length !== 3
    ) {

      continue;

    }


    const controlNo =
      parseInt(
        parts[2],
        10
      );


    if (
      !isNaN(controlNo) &&
      controlNo > maxControlNo
    ) {

      maxControlNo =
        controlNo;

    }

  }


  return maxControlNo + 1;

}


function generateSeriesNumberBacCentral_(
  dateObj,
  controlNo
) {

  const year =
    dateObj.getFullYear();


  const month =
    String(
      dateObj.getMonth() + 1
    ).padStart(
      2,
      "0"
    );


  return (
    year +
    "." +
    month +
    "." +
    controlNo
  );

}


function buildPurposeBacCentral_(
  category,
  purposeText,
  procurementType
) {

  const typeUpper =
    cleanValueCentral_(
      procurementType
    ).toUpperCase();


  const purposeLowerFirst =
    lowerFirstLetterCentral_(
      purposeText
    );


  if (
    typeUpper === "SERVICES" ||
    typeUpper === "SERVICE"
  ) {

    return (
      "Provision of " +
      toTitleCaseCentral_(category) +
      " Services " +
      purposeLowerFirst
    );

  }


  return (
    "Procurement of " +
    toTitleCaseCentral_(category) +
    " " +
    purposeLowerFirst
  );

}


function mapDivisionBacCentral_(
  division
) {

  const map = {

    PMEU: "CKGM",
    PAS: "JPA",
    ISS: "HCB",
    AFU: "ECF",
    CDMS: "JMRC"

  };


  return (
    map[
      cleanValueCentral_(
        division
      ).toUpperCase()
    ] ||
    division
  );

}


function makeFullKeyCentral_(
  prNo,
  category,
  supplier,
  amount
) {

  return [

    cleanValueCentral_(prNo)
      .toUpperCase(),

    cleanValueCentral_(category)
      .toUpperCase(),

    cleanValueCentral_(supplier)
      .toUpperCase(),

    cleanNumberCentral_(
      amount
    )

  ].join("||");

}


function makeFullKeyWithPurposeCentral_(
  prNo,
  category,
  supplier,
  amount,
  purpose
) {

  return [

    cleanValueCentral_(prNo)
      .toUpperCase(),

    cleanValueCentral_(category)
      .toUpperCase(),

    cleanValueCentral_(supplier)
      .toUpperCase(),

    cleanNumberCentral_(
      amount
    ),

    cleanValueCentral_(purpose)
      .toUpperCase()

  ].join("||");

}



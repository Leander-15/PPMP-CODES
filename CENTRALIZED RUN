// ============================================================
// PURCHASE ORDER SYNC
// ============================================================

function syncPurchaseOrdersCentral_(
  source,
  sourceSheet
) {

  // DATABASE COLUMN INDEXES
  const DB_COL_PR_NO = 1;              // A
  const DB_COL_PURPOSE = 10;           // J
  const DB_COL_DIVISION = 12;          // L
  const DB_COL_SUPPLIER = 30;          // AD
  const DB_COL_GROSS = 32;             // AF
  const DB_COL_CATEGORY = 33;          // AG
  const DB_COL_PO_NO = 44;             // AR
  const DB_COL_PROCUREMENT_TYPE = 45;  // AS
  const DB_COL_DOCUMENT_TYPE = 47;     // AU


  const targetSheet =
    getCentralSheet_(
      CENTRAL_SHEETS.PURCHASE_ORDERS
    );


  const sourceLastRow =
    sourceSheet.getLastRow();

  const sourceLastCol =
    sourceSheet.getLastColumn();


  if (sourceLastRow < 2) {

    Logger.log(
      source.name +
      ": No database rows found for PO."
    );

    return;

  }


  const sourceData =
    sourceSheet
      .getRange(
        1,
        1,
        sourceLastRow,
        sourceLastCol
      )
      .getValues();


  const targetData =
    targetSheet
      .getDataRange()
      .getValues();


  // ----------------------------------------------------------
  // EXISTING CENTRAL PO MAP
  // ----------------------------------------------------------

  const existingPoMap =
    new Map();


  const existingPoNumberRowMap =
    new Map();


  for (
    let i = 1;
    i < targetData.length;
    i++
  ) {

    const rowNumber =
      i + 1;


    const poNo =
      cleanValueCentral_(
        targetData[i][0]
      );

    const supplier =
      cleanValueCentral_(
        targetData[i][2]
      );

    const gross =
      cleanNumberCentral_(
        targetData[i][5]
      );

    const category =
      cleanValueCentral_(
        targetData[i][6]
      );

    const prNo =
      cleanValueCentral_(
        targetData[i][7]
      );


    if (
      poNo &&
      !existingPoNumberRowMap.has(poNo)
    ) {

      existingPoNumberRowMap.set(
        poNo,
        rowNumber
      );

    }


    if (
      !poNo ||
      !prNo ||
      !category ||
      !supplier ||
      !gross
    ) {

      continue;

    }


    const key =
      makePOKeyCentral_(
        prNo,
        category,
        supplier,
        gross
      );


    if (
      !existingPoMap.has(key)
    ) {

      existingPoMap.set(
        key,
        poNo
      );

    }

  }


  // ----------------------------------------------------------
  // GROUP DATABASE
  // ----------------------------------------------------------
  //
  // IMPORTANT:
  //
  // Each group stores:
  // - firstRow
  // - allRows
  // - control number from FIRST ROW
  //
  // If ANY row in the group has an AR number, the group
  // is treated as already processed.
  //
  // The number is written only to firstRow.
  // ----------------------------------------------------------

  const grouped =
    new Map();


  for (
    let i = 1;
    i < sourceData.length;
    i++
  ) {

    const row =
      sourceData[i];


    const prNo =
      cleanValueCentral_(
        row[DB_COL_PR_NO - 1]
      );

    const purposeText =
      cleanValueCentral_(
        row[DB_COL_PURPOSE - 1]
      );

    const division =
      cleanValueCentral_(
        row[DB_COL_DIVISION - 1]
      );

    const supplier =
      cleanValueCentral_(
        row[DB_COL_SUPPLIER - 1]
      );

    const grossAmount =
      cleanNumberCentral_(
        row[DB_COL_GROSS - 1]
      );

    const category =
      cleanValueCentral_(
        row[DB_COL_CATEGORY - 1]
      );

    const existingPoNoInDb =
      cleanValueCentral_(
        row[DB_COL_PO_NO - 1]
      );

    const procurementType =
      cleanValueCentral_(
        row[DB_COL_PROCUREMENT_TYPE - 1]
      );

    const documentType =
      cleanValueCentral_(
        row[DB_COL_DOCUMENT_TYPE - 1]
      ).toUpperCase();


    // --------------------------------------------------------
    // ONLY PO
    // --------------------------------------------------------

    if (
      documentType !== "PO"
    ) {

      continue;

    }


    // --------------------------------------------------------
    // REQUIRED / VITAL DATA
    // --------------------------------------------------------

    if (
      !prNo ||
      !category ||
      !supplier ||
      !purposeText ||
      !grossAmount
    ) {

      continue;

    }


    const key =
      makePOKeyCentral_(
        prNo,
        category,
        supplier,
        grossAmount
      );


    if (!grouped.has(key)) {

      grouped.set(
        key,
        {
          prNo: prNo,
          purposeText: purposeText,
          division: division,
          supplier: supplier,
          grossAmount: grossAmount,
          category: category,
          procurementType: procurementType,

          firstRow:
            i + 1,

          rowNumbers: [],

          existingControlNumbers: []

        }
      );

    }


    const group =
      grouped.get(key);


    group.rowNumbers.push(
      i + 1
    );


    if (existingPoNoInDb) {

      group.existingControlNumbers.push(
        existingPoNoInDb
      );

    }

  }


  // ----------------------------------------------------------
  // NUMBERING
  // ----------------------------------------------------------

  let nextControlNo =
    getNextControlNumberFromAllPOsCentral_(
      targetSheet
    );


  const now =
    new Date();


  const databaseUpdates =
    [];


  let rowsWritten =
    0;


  let matchedExistingCentral =
    0;


  let skippedAlreadyNumbered =
    0;


  // ----------------------------------------------------------
  // PROCESS GROUPS
  // ----------------------------------------------------------

  for (
    const [key, item]
    of grouped.entries()
  ) {

    // ========================================================
    // 1. LEAN CONTROL NUMBER CHECK
    // ========================================================
    //
    // If ANY row of the group already has AR populated,
    // the entire group is considered already processed.
    //
    // DO NOT:
    // - search Central
    // - write Central
    // - generate another number
    // - change AR
    //
    // ========================================================

    if (
      item.existingControlNumbers.length > 0
    ) {

      skippedAlreadyNumbered++;

      Logger.log(
        source.name +
        ": PO GROUP SKIPPED — already has AR number: " +
        item.existingControlNumbers.join(", ")
      );

      continue;

    }


    // ========================================================
    // 2. SEARCH CENTRAL FOR EXACT MATCH
    // ========================================================
    //
    // If found:
    // - DO NOT WRITE CENTRAL
    // - DO NOT GENERATE NEW NUMBER
    // - ONLY write existing number to FIRST ROW of LEAN
    // ========================================================

    if (
      existingPoMap.has(key)
    ) {

      const existingCentralPo =
        existingPoMap.get(key);


      databaseUpdates.push({
        row:
          item.firstRow,

        value:
          existingCentralPo
      });


      matchedExistingCentral++;


      Logger.log(
        source.name +
        ": PO MATCH FOUND IN CENTRAL → " +
        existingCentralPo +
        " → LEAN row " +
        item.firstRow
      );


      continue;

    }


    // ========================================================
    // 3. NO CENTRAL MATCH → CREATE NEW PO
    // ========================================================

    const poNoToUse =
      generatePONumberCentral_(
        now,
        nextControlNo
      );


    nextControlNo++;


    const nextAvailable =
      getNextAvailablePORowCentral_(
        targetSheet
      );


    const targetRow =
      nextAvailable.row;


    // --------------------------------------------------------
    // WRITE NEW PO TO CENTRAL
    // --------------------------------------------------------

    targetSheet
      .getRange(
        targetRow,
        1,
        1,
        8
      )
      .setValues([[
        poNoToUse,
        now,
        item.supplier,
        buildPurposePOCentral_(
          item.category,
          item.purposeText,
          item.procurementType
        ),
        mapDivisionPOCentral_(
          item.division
        ),
        item.grossAmount,
        item.category,
        item.prNo
      ]]);


    targetSheet
      .getRange(
        targetRow,
        2
      )
      .setNumberFormat(
        "mmmm d, yyyy"
      );


    targetSheet
      .getRange(
        targetRow,
        6
      )
      .setNumberFormat(
        "#,##0.00"
      );


    // Add newly created PO to local map
    existingPoMap.set(
      key,
      poNoToUse
    );


    existingPoNumberRowMap.set(
      poNoToUse,
      targetRow
    );


    rowsWritten++;


    // --------------------------------------------------------
    // WRITE PO ONLY TO FIRST ROW OF LEAN GROUP
    // --------------------------------------------------------

    databaseUpdates.push({
      row:
        item.firstRow,

      value:
        poNoToUse
    });


    Logger.log(
      source.name +
      ": NEW PO CREATED → " +
      poNoToUse +
      " → LEAN row " +
      item.firstRow
    );

  }


  // ----------------------------------------------------------
  // WRITE AR
  // ----------------------------------------------------------
  //
  // ONLY FIRST ROW OF EACH GROUP IS UPDATED.
  // ----------------------------------------------------------

  databaseUpdates.forEach(
    update => {

      sourceSheet
        .getRange(
          update.row,
          DB_COL_PO_NO
        )
        .setValue(
          update.value
        );

    }
  );


  SpreadsheetApp.flush();


  Logger.log(
    source.name +
    ": " +
    rowsWritten +
    " NEW PO row(s) written to Central."
  );


  Logger.log(
    source.name +
    ": " +
    matchedExistingCentral +
    " PO group(s) matched existing Central records."
  );


  Logger.log(
    source.name +
    ": " +
    skippedAlreadyNumbered +
    " PO group(s) skipped because AR already contained a number."
  );


  Logger.log(
    source.name +
    ": " +
    databaseUpdates.length +
    " LEAN first-row PO control number(s) updated."
  );

}


// ============================================================
// PO HELPERS
// ============================================================

function getNextAvailablePORowCentral_(sheet) {

  const START_ROW =
    2;

  const maxRows =
    sheet.getMaxRows();


  const values =
    sheet
      .getRange(
        START_ROW,
        1,
        maxRows - START_ROW + 1,
        8
      )
      .getValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    const poNo =
      cleanValueCentral_(
        row[0]
      );


    const dataBtoH =
      row.slice(1, 8);


    const isDataBlank =
      dataBtoH.every(
        cell =>
          cleanValueCentral_(cell) === ""
      );


    if (isDataBlank) {

      return {
        row:
          START_ROW + i,

        existingPoNo:
          poNo
      };

    }

  }


  sheet.insertRowAfter(
    maxRows
  );


  return {
    row:
      maxRows + 1,

    existingPoNo:
      ""
  };

}


function getNextControlNumberFromAllPOsCentral_(
  sheet
) {

  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {

    return 1;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        1
      )
      .getValues();


  let maxControlNo =
    0;


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const poNo =
      cleanValueCentral_(
        values[i][0]
      );


    if (!poNo) {

      continue;

    }


    const parts =
      poNo.split(".");


    if (
      parts.length !== 3
    ) {

      continue;

    }


    const controlNo =
      parseInt(
        parts[2],
        10
      );


    if (
      !isNaN(controlNo) &&
      controlNo > maxControlNo
    ) {

      maxControlNo =
        controlNo;

    }

  }


  return maxControlNo + 1;

}


function generatePONumberCentral_(
  dateObj,
  controlNo
) {

  const year =
    dateObj.getFullYear();


  const month =
    String(
      dateObj.getMonth() + 1
    ).padStart(
      2,
      "0"
    );


  return (
    year +
    "." +
    month +
    "." +
    controlNo
  );

}


function buildPurposePOCentral_(
  category,
  purposeText,
  procurementType
) {

  const typeUpper =
    cleanValueCentral_(
      procurementType
    ).toUpperCase();


  const purposeLowerFirst =
    lowerFirstLetterCentral_(
      purposeText
    );


  if (
    typeUpper === "SERVICES" ||
    typeUpper === "SERVICE"
  ) {

    return (
      "Provision of " +
      toTitleCaseCentral_(category) +
      " Services " +
      purposeLowerFirst
    );

  }


  return (
    "Procurement of " +
    toTitleCaseCentral_(category) +
    " " +
    purposeLowerFirst
  );

}


function mapDivisionPOCentral_(
  division
) {

  const map = {

    PMEU: "CKGM",
    PAS: "JPA",
    ISS: "HCB",
    AFU: "ECF",
    CDMS: "JMRC"

  };


  const key =
    cleanValueCentral_(
      division
    ).toUpperCase();


  return map[key] || division;

}


function makePOKeyCentral_(
  prNo,
  category,
  supplier,
  grossAmount
) {

  return [

    cleanValueCentral_(prNo)
      .toUpperCase(),

    cleanValueCentral_(category)
      .toUpperCase(),

    cleanValueCentral_(supplier)
      .toUpperCase(),

    cleanNumberCentral_(
      grossAmount
    )

  ].join("||");

}



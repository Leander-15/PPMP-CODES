// ============================================================
// GET UNIQUE SOURCE DATABASES
// ============================================================
//
// During testing LEAN 2 and LEAN 3 currently have the SAME
// Spreadsheet ID.
//
// This prevents the same physical DATABASE from being processed
// twice during one central run.
//
// Once LEAN 3 gets its real Spreadsheet ID, it will automatically
// be processed as a separate source.
// ============================================================

function getUniqueSourceDatabases_() {

  const seen = new Set();
  const uniqueSources = [];

  SOURCE_DATABASES.forEach(
    source => {

      const key =
        source.spreadsheetId +
        "||" +
        source.sheetName;

      if (seen.has(key)) {

        Logger.log(
          "SKIPPING DUPLICATE SOURCE: " +
          source.name +
          " → " +
          source.spreadsheetId
        );

        return;

      }

      seen.add(key);
      uniqueSources.push(source);

    }
  );

  return uniqueSources;

}


// ============================================================
// GET LEAN DATABASE
// ============================================================

function getLeanDatabaseCentral_(source) {

  const sourceSS =
    SpreadsheetApp.openById(
      source.spreadsheetId
    );

  const sourceSheet =
    sourceSS.getSheetByName(
      source.sheetName
    ) ||
    sourceSS.getSheetByName(
      "Database"
    );

  if (!sourceSheet) {

    throw new Error(
      source.name +
      ": DATABASE sheet not found."
    );

  }

  return {
    sourceSS: sourceSS,
    sourceSheet: sourceSheet
  };

}


// ============================================================
// GET CENTRAL SHEET
// ============================================================

function getCentralSheet_(sheetName) {

  const centralSS =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    centralSS.getSheetByName(
      sheetName
    );

  if (!sheet) {

    throw new Error(
      "Central sheet not found: " +
      sheetName
    );

  }

  return sheet;

}


// ============================================================
// SETUP CENTRAL AUTO RUN
// ============================================================

function setupCentralAutoRunTrigger() {

  const functionName =
    CENTRAL_AUTO_RUN_FUNCTION;


  ScriptApp.getProjectTriggers()
    .forEach(trigger => {

      if (
        trigger.getHandlerFunction() ===
        functionName
      ) {

        ScriptApp.deleteTrigger(
          trigger
        );

      }

    });


  ScriptApp.newTrigger(
    functionName
  )
    .timeBased()
    .everyMinutes(1)
    .create();


  Logger.log(
    "CENTRAL AUTO RUN TRIGGER CREATED."
  );

}


// ============================================================
// REMOVE CENTRAL AUTO RUN
// ============================================================

function removeCentralAutoRunTrigger() {

  const functionName =
    CENTRAL_AUTO_RUN_FUNCTION;


  ScriptApp.getProjectTriggers()
    .forEach(trigger => {

      if (
        trigger.getHandlerFunction() ===
        functionName
      ) {

        ScriptApp.deleteTrigger(
          trigger
        );

      }

    });


  Logger.log(
    "CENTRAL AUTO RUN TRIGGER REMOVED."
  );

}


// ============================================================
// CENTRAL AUTO PIPELINE
// ============================================================
//
// ORDER:
//
// 1. PO
// 2. BAC RES
// 3. CONTRACT
//
// ONE SCRIPT LOCK PROTECTS THE WHOLE PIPELINE.
// ============================================================

function runCentralAutoPipeline() {

  const lock =
    LockService.getScriptLock();


  if (
    !lock.tryLock(
      CENTRAL_LOCK_TIMEOUT
    )
  ) {

    Logger.log(
      "CENTRAL AUTO RUN SKIPPED — " +
      "another central run is already active."
    );

    return;

  }


  try {

    Logger.log(
      "================================================"
    );

    Logger.log(
      "CENTRAL AUTO PIPELINE START"
    );

    Logger.log(
      "Time: " +
      new Date()
    );

    Logger.log(
      "================================================"
    );


    // ========================================================
    // STEP 1 — PURCHASE ORDERS
    // ========================================================

    Logger.log(
      "STEP 1/3 — PURCHASE ORDERS"
    );

    syncAllPurchaseOrdersCentral_();


    // ========================================================
    // STEP 2 — BAC RES
    // ========================================================

    Logger.log(
      "STEP 2/3 — BAC RESOLUTIONS"
    );

    syncAllBacResCentral_();


    // ========================================================
    // STEP 3 — CONTRACTS
    // ========================================================

    Logger.log(
      "STEP 3/3 — CONTRACT NUMBERS"
    );

    syncAllContractNumbersCentral_();


    Logger.log(
      "================================================"
    );

    Logger.log(
      "CENTRAL AUTO PIPELINE COMPLETE"
    );

    Logger.log(
      "================================================"
    );


  } catch (error) {

    Logger.log(
      "================================================"
    );

    Logger.log(
      "CENTRAL AUTO PIPELINE ERROR"
    );

    Logger.log(
      "Message: " +
      error.message
    );

    Logger.log(
      "Stack: " +
      (
        error.stack ||
        ""
      )
    );

    Logger.log(
      "================================================"
    );


  } finally {

    lock.releaseLock();

  }

}


